{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botgo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "triggers": { "crons": ["17 * * * *", "23 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botgo",
      // Set the real database_id locally or in CI from the Cloudflare dashboard or `wrangler d1 create`. Do not commit it.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DESKTOP_RELEASES",
      "bucket_name": "botgo-desktop-releases"
    }
  ],
  "vars": {
    "AUTO_REVIEW_ENABLED": "0",
    // Placeholder only. Replace with your 16-digit Alipay App ID locally or in CI. Do not commit the real App ID.
    "ALIPAY_APP_ID": "YOUR_ALIPAY_APP_ID",
    "ALIPAY_SIGN_TYPE": "RSA2",
    "ALIPAY_GATEWAY": "https://openapi.alipay.com/gateway.do",
    "ALIPAY_NOTIFY_URL": "https://your-domain.example/api/billing/notify",
    "ALIPAY_RETURN_URL": "https://your-domain.example/api/billing/return"
  }
}
