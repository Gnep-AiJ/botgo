{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botgo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "triggers": { "crons": ["17 * * * *", "23 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botgo",
      "database_id": "955ea0bd-0b55-43a5-97e6-ee7a7a5a7104"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DESKTOP_RELEASES",
      "bucket_name": "botgo-desktop-releases"
    }
  ],
  "vars": {
    "AUTO_REVIEW_ENABLED": "0",
    "ALIPAY_APP_ID": "2021006196695598",
    "ALIPAY_SIGN_TYPE": "RSA2",
    "ALIPAY_GATEWAY": "https://openapi.alipay.com/gateway.do",
    "ALIPAY_NOTIFY_URL": "https://botgo.win/api/billing/notify",
    "ALIPAY_RETURN_URL": "https://botgo.win/api/billing/return"
  }
}
