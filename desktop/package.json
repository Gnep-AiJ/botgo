{
  "name": "botgo-desktop",
  "version": "1.2.1-preview.2",
  "private": true,
  "description": "BotGo Desktop for Windows",
  "main": "main.cjs",
  "scripts": {
    "prestart": "node scripts/sync-assets.cjs && node scripts/create-windows-icon.cjs",
    "start": "electron .",
    "test": "node ../tests/desktop-auth.test.mjs && node ../tests/desktop-web-authorization.test.mjs && node ../tests/desktop-web-auth.test.cjs && node ../tests/desktop-runtime.test.cjs && node ../tests/desktop-ui-contract.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check lib/local-state.cjs && node --check lib/credential-store.cjs && node --check lib/codex-config.cjs && node --check lib/web-auth.cjs",
    "prepackage:win": "node scripts/sync-assets.cjs && node scripts/create-windows-icon.cjs && node scripts/create-nsis-assets.cjs && node scripts/write-runtime-config.cjs",
    "package:win": "electron-builder --win nsis",
    "release:metadata": "node scripts/release-metadata.cjs"
  },
  "devDependencies": {
    "electron": "37.2.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.botgo.desktop",
    "productName": "BotGo Desktop",
    "asar": true,
    "afterPack": "scripts/verify-packaged-runtime.cjs",
    "compression": "maximum",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "renderer.css",
      "polish.css",
      "lib/**",
      "assets/**",
      "runtime-config.cjs",
      "package.json",
      "!dist{,/**}"
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "assets/botgo-desktop.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerIcon": "assets/botgo-desktop.ico",
      "uninstallerIcon": "assets/botgo-desktop.ico"
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses/Apache-2.0.txt",
        "to": "licenses/Apache-2.0.txt"
      },
      {
        "from": "../agent/lib",
        "to": "agent/lib"
      },
      {
        "from": "../agent/node_modules/@openai/codex-win32-x64",
        "to": "agent/node_modules/@openai/codex-win32-x64"
      }
    ]
  }
}
